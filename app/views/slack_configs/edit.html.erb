<h1 class="text-xl font-bold text-gray-900 mb-6">Slack通知設定</h1>

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 max-w-lg">
  <%= form_with model: @slack_config, url: slack_config_path do |f| %>

    <div class="mb-4">
      <%= f.label :webhook_url, "Webhook URL", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= f.url_field :webhook_url,
          placeholder: "https://hooks.slack.com/services/...",
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
    </div>

    <div class="mb-4">
      <%= f.label :bot_name, "Bot名", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= f.text_field :bot_name,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
    </div>

    <% if current_tenant.plan == "pro" %>
      <div class="mb-4">
        <%= f.label :enter_message, "入室メッセージ", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_area :enter_message, rows: 2,
            placeholder: "🟢 {name} さんが入室しました",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
        <p class="text-xs text-gray-400 mt-1">{name} が名前に置き換わります</p>
      </div>

      <div class="mb-4">
        <%= f.label :leave_message, "退室メッセージ", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_area :leave_message, rows: 2,
            placeholder: "🔴 {name} さんが退室しました",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
      </div>
    <% else %>
      <div class="mb-4 bg-gray-50 rounded-xl px-4 py-3 text-sm text-gray-500">
        <p class="font-medium text-gray-600 mb-2">通知メッセージ（デフォルト）</p>
        <p>🟢 入室 ○○ さん</p>
        <p>🔴 退室 ○○ さん</p>
        <p class="mt-2 text-xs text-gray-400">
          メッセージのカスタマイズは
          <span class="font-medium text-indigo-500">Pro プラン</span>
          で利用できます
        </p>
      </div>
    <% end %>

    <% if current_tenant.plan.in?(%w[standard pro]) %>
      <div class="mb-6">
        <%= f.label :allowed_ip_range, "許可IPレンジ（Wi-Fi制限）", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :allowed_ip_range,
            placeholder: "192.168.1.0/24",
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
        <p class="text-xs text-gray-400 mt-1">空欄の場合は制限なし</p>
      </div>
    <% end %>

    <%= f.submit "保存する",
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl text-sm cursor-pointer transition" %>
  <% end %>
</div>
