<div class="min-h-screen flex items-center justify-center -mt-8">
  <div class="w-full max-w-sm">

    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-14 h-14 bg-indigo-600 rounded-2xl mb-4 shadow-lg">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900">TapIn</h1>
      <p class="text-sm text-gray-500 mt-1">管理画面にログイン</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-4">
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
        </div>

        <div class="mb-6">
          <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              placeholder: "••••••••",
              class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
        </div>

        <%= f.submit "ログイン",
            class: "w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-2.5 px-4 rounded-xl text-sm cursor-pointer transition shadow-sm" %>

      <% end %>

      <p class="text-center text-sm text-gray-400 mt-5">
        アカウントをお持ちでない方は
        <%= link_to "新規登録", new_user_registration_path, class: "text-indigo-600 font-medium hover:underline" %>
      </p>
    </div>

  </div>
</div>
