<!DOCTYPE html>
<html>
  <head>
    <title>TapIn</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <% if user_signed_in? %>
      <nav class="bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
        <span class="font-bold text-lg text-indigo-600">TapIn</span>
        <div class="flex items-center gap-4 text-sm">
          <%= link_to "ダッシュボード", dashboard_path, class: "text-gray-600 hover:text-indigo-600" %>
          <%= link_to "NFCタグ", nfc_tags_path, class: "text-gray-600 hover:text-indigo-600" %>
          <%= link_to "Slack設定", edit_slack_config_path, class: "text-gray-600 hover:text-indigo-600" %>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-400 hover:text-red-500" %>
        </div>
      </nav>

      <% if Rails.env.development? %>
        <div class="bg-amber-50 border-b border-amber-200 px-4 py-2 flex items-center gap-3 text-xs text-amber-700">
          <span class="font-semibold">DEV</span>
          <span>プラン切り替え:</span>
          <% %w[free standard pro].each do |plan| %>
            <%= button_to plan.capitalize,
                dev_plan_switcher_path,
                params: { plan: plan },
                method: :patch,
                class: "px-2 py-0.5 rounded font-medium transition " +
                  (current_tenant.plan == plan ?
                    "bg-amber-500 text-white" :
                    "bg-white border border-amber-300 hover:bg-amber-100") %>
          <% end %>
          <span class="ml-2 text-amber-500">現在: <%= current_tenant.plan %></span>
        </div>
      <% end %>
    <% end %>

    <% if notice.present? %>
      <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm text-center"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm text-center"><%= alert %></div>
    <% end %>
    <main class="max-w-4xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
